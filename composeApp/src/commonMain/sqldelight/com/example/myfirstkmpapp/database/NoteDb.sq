CREATE TABLE IF NOT EXISTS NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    color INTEGER NOT NULL,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    timestamp INTEGER NOT NULL,
    cloudId TEXT
);

getAllNotes:
SELECT *
FROM NoteEntity
ORDER BY timestamp DESC;

getNotesByQuery:
SELECT *
FROM NoteEntity
WHERE title LIKE '%' || :query || '%' OR content LIKE '%' || :query || '%'
ORDER BY timestamp DESC;

getFavoriteNotes:
SELECT *
FROM NoteEntity
WHERE isFavorite = 1
ORDER BY timestamp DESC;

getNoteById:
SELECT *
FROM NoteEntity
WHERE id = ?;

insertNote:
INSERT INTO NoteEntity(title, content, color, isFavorite, timestamp, cloudId)
VALUES (?, ?, ?, ?, ?, ?);

updateNote:
UPDATE NoteEntity
SET title = ?, content = ?, color = ?, isFavorite = ?, timestamp = ?, cloudId = ?
WHERE id = ?;

deleteNoteById:
DELETE FROM NoteEntity
WHERE id = ?;

updateFavoriteStatus:
UPDATE NoteEntity
SET isFavorite = ?
WHERE id = ?;
